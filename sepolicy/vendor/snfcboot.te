# Powers the NFC controller up through the BD7602 regulator once at early-boot.
type snfcboot, domain;
type snfcboot_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(snfcboot)

allow snfcboot nfc_device:chr_file rw_file_perms;

# Drops to the nfc user after opening the device nodes.
allow snfcboot self:global_capability_class_set setuid;

# ro.vendor.boot.warmboot
get_prop(snfcboot, vendor_default_prop)
